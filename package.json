{
  "name": "archipelago",
  "version": "0.2.0",
  "type": "module",
  "private": true,
  "bin": {
    "archipelago": "src/cli/index.ts"
  },
  "scripts": {
    "test": "bun test",
    "check": "bunx tsc --noEmit",
    "serve": "bun run src/cli/index.ts serve",
    "archipelago": "bun run src/cli/index.ts",
    "vendor:mermaid": "cp node_modules/mermaid/dist/mermaid.min.js src/server/vendor/mermaid.min.js",
    "test:wasm": "bun test --preload ./tests/support/wasm-driver.ts tests/core tests/server tests/web",
    "build:web": "bun run scripts/build-web.ts",
    "conformance": "bun run scripts/conformance.ts",
    "deploy:web": "bun run build:web && bunx wrangler@4.148.0 pages deploy dist/web --project-name archipelago --branch main"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.260",
    "@anthropic-ai/sdk": "0.123.0",
    "commander": "12.1.0",
    "function-plot": "1.25.3",
    "shiki": "3.23.0",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@sqlite.org/sqlite-wasm": "3.53.4-build2",
    "@types/bun": "1.4.0",
    "mermaid": "11.17.2",
    "typescript": "5.9.3"
  }
}
