#!/usr/bin/env bash
# The archipelago command. As a Claude Code plugin, this bin/ is on the Bash tool's PATH; in a clone, `bun link` does the same.
set -euo pipefail
root="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"
if ! command -v bun >/dev/null 2>&1; then
  echo '{"error":"Archipelago needs Bun: install it from https://bun.sh, then run the command again."}'
  exit 1
fi
# Claude Code installs the plugin's dependencies itself; this covers an install that timed out or a fresh clone.
if [ ! -d "$root/node_modules/@anthropic-ai/claude-agent-sdk" ]; then
  (cd "$root" && bun install --frozen-lockfile --production >&2)
fi
exec bun "$root/src/cli/index.ts" "$@"
